│          self.db.commit()                                                    │
│          return cursor.lastrowid                                             │
│                                                                              │
│      def get_by_code(self, short_code: str) -> Optional[dict]:               │
│          row = self.db.execute(                                              │
│              "SELECT * FROM urls WHERE short_code = ?",                      │
│              (short_code,)                                                   │
