# Настройки приложения Notes API
# Скопируйте этот файл в .env и измените значения при необходимости

# Хост для запуска сервера
HOST=0.0.0.0

# Порт для запуска сервера
PORT=8000

# Путь к файлу хранилища заметок
STORAGE_FILE=/app/data/notes.json

# Режим отладки (включает автоматическую перезагрузку при изменениях кода)
DEBUG=true
