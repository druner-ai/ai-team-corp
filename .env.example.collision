# URL Shortener Configuration
# Copy this file to .env and adjust values as needed.

# Application port
APP_PORT=8000

# Database file path (inside container, relative to /app/data)
DATABASE_PATH=/app/data/shortener.db

# Base URL for constructing short links
BASE_URL=http://localhost:8000

# Length of generated short codes
CODE_LENGTH=6

# Maximum allowed length for original URLs
MAX_URL_LENGTH=2048

# Maximum attempts to generate a unique code before failing
MAX_CODE_GENERATION_ATTEMPTS=5
